{
  "name": "@groundcrew/server",
  "version": "0.1.0",
  "private": true,
  "description": "Event bridge: receives Claude Code hook payloads over HTTP and broadcasts normalized AgentEvents over WebSocket.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:ws"
  },
  "dependencies": {
    "@groundcrew/shared": "0.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
