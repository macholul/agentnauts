# Copy to server/.env to configure the event bridge.

# Port and bind address (loopback only by default).
# PORT=4747
# HOST=127.0.0.1

# --- Multiplayer (optional) -------------------------------------------------
# Share your agents in a room on Supabase Realtime. Everyone in the room must
# use the same Supabase project and room code.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# GROUNDCREW_ROOM=choose-a-long-random-code
# GROUNDCREW_NAME=your-name
# Also share file names, commands and search queries (off by default).
# GROUNDCREW_SHARE_DETAILS=1
