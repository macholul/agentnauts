# Optional: copy to server/.env. Nothing here is needed for normal use.

# Port and bind address (loopback only by default).
# PORT=4747
# HOST=127.0.0.1

# Where the web app lives, for the "connect this computer" link the daemon prints.
# AGENTNAUTS_APP_URL=http://localhost:5173

# Use a different Supabase project than the one in shared/src/cloud.ts.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
