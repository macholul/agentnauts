# Optional: copy to server/.env. Nothing here is needed for normal use.

# Port and bind address (loopback only by default).
# PORT=4747
# HOST=127.0.0.1

# --- Multiplayer overrides ---------------------------------------------------
# Rooms are normally joined from the web app. These pin the bridge instead.
# GROUNDCREW_ROOM=crew-abcd-efgh-jkmn
# GROUNDCREW_NAME=your-name
# GROUNDCREW_SHARE_DETAILS=1
# Use a different Supabase project than the one in shared/src/cloud.ts.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
