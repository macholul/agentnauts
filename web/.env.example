# Optional: copy to web/.env. Nothing here is needed for normal use.

# Local mode: read events straight from a daemon on this machine, with no
# account and nothing sent anywhere.
# VITE_LOCAL_BRIDGE=1
# Where that daemon is (default ws://<page host>:4747/ws).
# VITE_BRIDGE_URL=ws://localhost:4747/ws

# Use a different Supabase project than the one in shared/src/cloud.ts.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
