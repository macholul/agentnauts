# Copy to web/.env to configure the web app.

# Where the local event bridge is (default ws://<page host>:4747/ws).
# VITE_BRIDGE_URL=ws://localhost:4747/ws

# --- Multiplayer (optional) -------------------------------------------------
# Same Supabase project as the bridge's SUPABASE_URL / SUPABASE_ANON_KEY.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
